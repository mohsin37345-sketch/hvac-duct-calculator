---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import { t, getLocalizedUrl, locales } from '@theme/i18n/utils';
import { footerNav } from '@src/config/site';
import { getCollection } from 'astro:content';

const locale = 'en';
const posts = await getCollection('blog');

const pages = footerNav.map((item) => ({
  label: t(locale, item.key),
  url: getLocalizedUrl(locale, item.path),
}));

const ductSizes = [4, 6, 8, 10, 12, 14, 16, 18, 20, 24];
const roomSizes = [100, 150, 200, 300, 400, 500, 750, 1000, 1500, 2000];
const homeSizes = [500, 1000, 1500, 2000, 2500, 3000, 3500, 4000, 5000];
---

<BaseLayout title={t(locale, 'sitemap.title')} locale={locale} noindex={true}>
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-extrabold text-silver-900 mb-6">{t(locale, 'sitemap.title')}</h1>

    <div class="glass-card p-6 sm:p-8 space-y-8">
      <div>
        <h2 class="text-lg font-bold text-silver-800 mb-3">{t(locale, 'sitemap.pages')}</h2>
        <ul class="space-y-2">
          <li><a href={getLocalizedUrl(locale, '/')} class="text-accent hover:underline">{t(locale, 'nav.home')}</a></li>
          <li><a href="/duct-size-chart-cfm/" class="text-accent hover:underline">Duct Size Chart: CFM (Round, Rectangular &amp; Flex)</a></li>
          {pages.map((page) => (
            <li><a href={page.url} class="text-accent hover:underline">{page.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-lg font-bold text-silver-800 mb-3">Duct Size Calculators</h2>
        <ul class="space-y-2">
          {ductSizes.map((size) => (
            <li><a href={`/duct-calculator-${size}-inch/`} class="text-accent hover:underline">{size} Inch Duct Calculator</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-lg font-bold text-silver-800 mb-3">CFM by Room Size</h2>
        <ul class="space-y-2">
          {roomSizes.map((sqft) => (
            <li><a href={`/cfm-calculator-${sqft}-sqft/`} class="text-accent hover:underline">CFM Calculator for {sqft} Sq Ft Room</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-lg font-bold text-silver-800 mb-3">Whole Home Duct Sizing</h2>
        <ul class="space-y-2">
          {homeSizes.map((sqft) => (
            <li><a href={`/hvac-duct-sizing-for-${sqft}-sqft/`} class="text-accent hover:underline">HVAC Duct Sizing for {sqft.toLocaleString()} Sq Ft Home</a></li>
          ))}
        </ul>
      </div>

      {posts.length > 0 && (
        <div>
          <h2 class="text-lg font-bold text-silver-800 mb-3">{t(locale, 'sitemap.blog')}</h2>
          <ul class="space-y-2">
            {posts.map((post) => (
              <li>
                <a href={getLocalizedUrl(locale, `/blog/${post.id}`)} class="text-accent hover:underline">{post.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div>
        <h2 class="text-lg font-bold text-silver-800 mb-3">{t(locale, 'footer.language')}</h2>
        <div class="flex flex-wrap gap-2">
          {locales.map((l) => (
            <a href={getLocalizedUrl(l.code, '/')} class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-silver-100 text-silver-600 hover:bg-accent-subtle hover:text-accent transition-colors">
              {l.nativeName}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
