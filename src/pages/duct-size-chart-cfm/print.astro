---
// Standalone printable reference page
const roundDuctData = [
  { size: 4, cfm: 37, velocity: 426, use: 'Bath exhaust' },
  { size: 5, cfm: 67, velocity: 492, use: 'Small bedroom' },
  { size: 6, cfm: 109, velocity: 553, use: 'Standard bedroom' },
  { size: 7, cfm: 163, velocity: 611, use: 'Master bedroom' },
  { size: 8, cfm: 232, velocity: 666, use: 'Living branch / trunk' },
  { size: 9, cfm: 317, velocity: 718, use: 'Zone trunk' },
  { size: 10, cfm: 419, velocity: 768, use: '1-Ton main trunk' },
  { size: 12, cfm: 678, velocity: 863, use: '1.5–2 Ton main trunk' },
  { size: 14, cfm: 1019, velocity: 953, use: '2.5-Ton trunk (953 FPM)' },
  { size: 16, cfm: 1450, velocity: 1039, use: '3.5–4 Ton trunk' },
  { size: 18, cfm: 1980, velocity: 1120, use: '5-Ton trunk / light comm.' },
  { size: 20, cfm: 2615, velocity: 1199, use: 'Commercial trunk' },
