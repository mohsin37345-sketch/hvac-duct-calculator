---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import { t } from '@theme/i18n/utils';

const locale = 'en';
---

<BaseLayout title={t(locale, 'about.title')} description={t(locale, 'about.description')} locale={locale} schemaType="about">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-extrabold text-silver-900 mb-8">{t(locale, 'about.title')}</h1>
    
    <div class="space-y-12">
      <!-- Mission -->
      <section class="glass-card p-6 sm:p-10">
        <h2 class="text-2xl font-bold text-silver-800 mb-4">Our Mission</h2>
        <p class="text-silver-600 leading-relaxed text-lg">{t(locale, 'about.content1')}</p>
      </section>

      <!-- Methodology -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="glass-card p-6 sm:p-8">
          <h2 class="text-xl font-bold text-silver-800 mb-4">The Methodology</h2>
          <p class="text-silver-600 text-sm leading-relaxed mb-4">{t(locale, 'about.content2')}</p>
          <a href="/methodology" class="text-accent text-sm font-bold hover:underline">View Detailed Methodology →</a>
        </div>
        <div class="glass-card p-6 sm:p-8">
          <h2 class="text-xl font-bold text-silver-800 mb-4">Professional Use</h2>
          <p class="text-silver-600 text-sm leading-relaxed mb-4">{t(locale, 'about.content3')}</p>
          <p class="text-silver-600 text-sm italic">Verified Calculations for ASHRAE compliance.</p>
        </div>
      </section>

      <!-- Contact -->
      <section class="glass-card p-6 sm:p-10 border-t-4 border-accent">
        <h2 class="text-2xl font-bold text-silver-800 mb-4">Contact Information</h2>
        <p class="text-silver-600 mb-6">Have questions or feedback about our calculator? We'd love to hear from you.</p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact-us" class="btn-primary">Send a Message</a>
          <div class="p-3 px-5 rounded-lg bg-silver-50 border border-silver-100 text-silver-700 font-mono text-sm">
            Email: mohsin37345@gmail.com
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
