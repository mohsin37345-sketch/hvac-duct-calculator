---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { t, getLocalizedUrl } from '@theme/i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const locale = 'en';
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  locale={locale}
  schemaType="article"
  articleData={{
    title: post.data.title,
    description: post.data.description,
    image: post.data.image,
    datePublished: post.data.date.toISOString(),
    author: post.data.author,
  }}
>
  <article class="max-w-3xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="text-xs text-silver-400 mb-6 flex items-center gap-2">
      <a href={getLocalizedUrl(locale, '/')} class="hover:text-accent">{t(locale, 'nav.home')}</a>
      <span>/</span>
      <a href={getLocalizedUrl(locale, '/blog')} class="hover:text-accent">{t(locale, 'nav.blog')}</a>
      <span>/</span>
      <span class="text-silver-600">{post.data.title}</span>
    </nav>

    <!-- Hero -->
    <header class="mb-8">
      {post.data.category && (
        <span class="inline-block text-xs font-bold text-accent uppercase tracking-wider mb-3">{post.data.category}</span>
      )}
      <h1 class="text-3xl sm:text-4xl font-extrabold text-silver-900 leading-tight mb-3">{post.data.title}</h1>
      <div class="flex items-center gap-4 text-sm text-silver-500">
        <span>{post.data.author}</span>
        <span>·</span>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
    </header>

    {post.data.image && (
      <img src={post.data.image} alt={post.data.title} class="w-full rounded-2xl mb-8 shadow-md" />
    )}

    <div class="glass-card p-6 sm:p-8 prose">
      <Content />
    </div>

    <!-- CTA Section -->
    <div class="mt-12 p-8 rounded-2xl bg-gradient-to-br from-silver-900 to-silver-800 text-white shadow-xl">
      <h3 class="text-xl font-bold mb-4">Need to size your ducts?</h3>
      <p class="text-silver-300 text-sm mb-6">Use our free professional HVAC duct calculator to get accurate sizing for round, rectangular, and flex ducts.</p>
      <a href={getLocalizedUrl(locale, '/')} class="inline-flex items-center gap-2 px-6 py-3 bg-accent hover:bg-accent/90 text-white font-bold rounded-lg transition-all shadow-lg shadow-accent/20">
        Go to Duct Calculator
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="mt-8 text-center">
      <a href={getLocalizedUrl(locale, '/blog')} class="text-silver-500 font-semibold hover:text-accent transition-colors">
        ← Back to {t(locale, 'nav.blog')}
      </a>
    </div>
  </article>
</BaseLayout>
