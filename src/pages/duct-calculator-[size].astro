---
import BaseLayout from '@theme/layouts/BaseLayout.astro';

export function getStaticPaths() {
  const sizes = [4, 6, 8, 10, 12, 14, 16, 18, 20, 24];
  return sizes.map((size) => {
    const area = Math.PI * Math.pow(size / 24, 2);
    const velocities = [600, 700, 800, 900];
    const cfmData = velocities.map((v) => ({
      velocity: v,
      cfm: Math.round(area * v),
    }));
    const rectEquiv = size === 6 ? '8x4 or 6x6' : 
                      size === 8 ? '10x6 or 8x8' :
                      size === 10 ? '14x8 or 12x10' :
                      size === 12 ? '16x8 or 14x10' :
                      size === 14 ? '20x8 or 18x10' :
                      size === 16 ? '24x8 or 20x10' :
                      size === 18 ? '26x10 or 22x12' :
                      size === 20 ? '30x10 or 24x12' : 'N/A';
    
    const maxCFM = Math.round(area * 900);
    const minCFM = Math.round(area * 500);

    return {
      params: { size: `${size}-inch` },
      props: { size, cfmData, rectEquiv, maxCFM, minCFM },
    };
  });
}

const { size, cfmData, rectEquiv, maxCFM, minCFM } = Astro.props;
const area = Math.PI * Math.pow(size / 24, 2);
const title = `${size} Inch Duct Calculator: CFM Capacity & Sizing Guide`;
const description = `What is the CFM for a ${size} inch duct? Calculate airflow capacity, velocity limits, and rectangular equivalents for ${size}" HVAC ducts. Includes metal and flex duct notes.`;

const allSizes = [4, 6, 8, 10, 12, 14, 16, 18, 20, 24];
---

<BaseLayout title={title} description={description} locale="en" schemaType="website">
  <div class="prog-hero">
    <h1>{size} Inch Duct Calculator</h1>
    <p>{description}</p>
  </div>

  <div class="glass-card p-6 sm:p-8 mb-8">
    <h2 class="content-heading">Airflow Capacity for {size}" Round Duct</h2>
    <p class="content-text">
      A {size} inch round duct has a cross sectional area of {(area * 144).toFixed(1)} square inches
      ({area.toFixed(3)} sq ft). The table below shows the CFM airflow at different air velocities.
    </p>

    <div class="glass-card overflow-hidden">
      <table class="prog-table">
        <thead>
          <tr>
            <th>Velocity (FPM)</th>
            <th>Airflow (CFM)</th>
            <th>Noise Level</th>
            <th>Use Case</th>
          </tr>
        </thead>
        <tbody>
          {cfmData.map((row: { velocity: number; cfm: number }) => (
            <tr>
              <td class="font-mono font-medium">{row.velocity} FPM</td>
              <td class="font-mono font-bold text-accent">{row.cfm} CFM</td>
              <td>{row.velocity <= 700 ? '✅ Quiet' : row.velocity <= 800 ? '⚠️ Moderate' : '🔊 May be noisy'}</td>
              <td>{row.velocity <= 700 ? 'Residential supply' : row.velocity <= 800 ? 'Commercial supply' : 'Industrial'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="glass-card p-6 sm:p-8 mb-8">
    <h2 class="content-heading">Technical Specifications</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="p-4 rounded-xl border border-silver-100 bg-silver-50/50">
        <h3 class="text-xs font-bold text-silver-400 uppercase tracking-widest mb-2">Rectangular Equivalent</h3>
        <p class="text-lg font-bold text-silver-900">{rectEquiv} inches</p>
        <p class="text-[0.7rem] text-silver-500 mt-1">Based on ASHRAE equivalent diameter formulas.</p>
      </div>
      <div class="p-4 rounded-xl border border-silver-100 bg-silver-50/50">
        <h3 class="text-xs font-bold text-silver-400 uppercase tracking-widest mb-2">Max Recommended CFM</h3>
        <p class="text-lg font-bold text-silver-900">{maxCFM} CFM</p>
        <p class="text-[0.7rem] text-silver-500 mt-1">Based on 900 FPM (max residential velocity).</p>
      </div>
    </div>
  </div>

  <div class="glass-card p-6 sm:p-8 mb-8">
    <h2 class="content-heading">{size} Inch Metal vs. Flex Duct</h2>
    <div class="space-y-4">
      <p class="text-silver-600 text-sm">
        While the nominal diameter is the same, <strong>{size}" flexible duct</strong> has significantly higher air resistance than smooth <strong>{size}" galvanized sheet metal duct</strong>.
      </p>
      <ul class="list-disc pl-5 text-sm text-silver-600 space-y-2">
        <li><strong>Metal Duct:</strong> Delivers approximately {cfmData[1].cfm} CFM at 0.1 friction rate.</li>
        <li><strong>Flex Duct:</strong> Usually requires a 1.5x resistance factor. To deliver the same airflow, you may need to increase to a {size + 2}" flex duct.</li>
        <li><strong>Return Air:</strong> For a return duct, a {size}" round duct is generally limited to {minCFM} CFM to maintain quiet operation (600 FPM).</li>
      </ul>
    </div>
  </div>

  <div class="prog-cta">
    <a href="/" class="btn-primary">Calculate Exact Sizing Online →</a>
  </div>

  <div class="glass-card p-6 sm:p-8 mb-8">
    <h2 class="content-heading">Frequently Asked Questions</h2>
    <div class="space-y-6">
      <div>
        <h3 class="text-base font-bold text-silver-900 mb-2">How much CFM can a {size} inch duct handle?</h3>
        <p class="text-sm text-silver-600">A {size} inch round duct can handle between {minCFM} and {maxCFM} CFM. For residential supply branches, it is typically used for {cfmData[1].cfm} CFM at 0.08 friction rate.</p>
      </div>
      <div>
        <h3 class="text-base font-bold text-silver-900 mb-2">What is the rectangular equivalent of {size}" round?</h3>
        <p class="text-sm text-silver-600">The most common rectangular equivalents for a {size} inch round duct are {rectEquiv} inches.</p>
      </div>
    </div>
  </div>

  <div class="glass-card p-6 sm:p-8">
    <h2 class="content-heading">Other Duct Sizes</h2>
    <div class="flex flex-wrap gap-2">
      {allSizes.filter((s) => s !== size).map((s) => (
        <a href={`/duct-calculator-${s}-inch/`} class="px-3 py-1.5 rounded-md bg-silver-100 text-silver-600 text-xs font-bold hover:bg-accent hover:text-white transition-all">{s}" Duct</a>
      ))}
    </div>
  </div>
</BaseLayout>
