---
import { footerNav, siteConfig, socialLinks } from '@src/config/site';
import { t, getLocalizedUrl } from '@theme/i18n/utils';
import LocaleSwitcher from './LocaleSwitcher.astro';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-silver-200 bg-white/60 backdrop-blur-lg mt-12">
  <div class="max-w-[1200px] w-full mx-auto px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <a href={getLocalizedUrl(locale, '/')} class="flex items-center gap-3 no-underline mb-3">
          <div class="w-9 h-9 flex items-center justify-center rounded-lg bg-gradient-to-br from-[#5b6abf] to-[#4a58a8]">
            <svg viewBox="0 0 40 40" fill="none" class="w-5 h-5">
              <rect x="4" y="8" width="32" height="6" rx="1.5" fill="#fff"/>
              <rect x="8" y="14" width="4" height="14" rx="1" fill="#fff"/>
              <rect x="18" y="14" width="4" height="14" rx="1" fill="#fff"/>
              <rect x="28" y="14" width="4" height="14" rx="1" fill="#fff"/>
              <rect x="4" y="28" width="32" height="5" rx="1.5" fill="#fff"/>
            </svg>
          </div>
          <span class="font-bold text-silver-900">{t(locale, 'site.title')}</span>
        </a>
        <p class="text-sm text-silver-500 leading-relaxed max-w-xs">{t(locale, 'footer.description')}</p>
      </div>

      <!-- Nav Links -->
      <div>
        <h4 class="font-semibold text-silver-800 text-sm uppercase tracking-wider mb-3">{t(locale, 'nav.home')}</h4>
        <nav class="flex flex-col gap-2">
          {footerNav.map((item) => (
            <a
              href={getLocalizedUrl(locale, item.path)}
              class="text-sm text-silver-500 hover:text-accent transition-colors"
            >
              {t(locale, item.key)}
            </a>
          ))}
        </nav>
      </div>

      <!-- Social + Locale -->
      <div class="flex flex-col gap-4">
        {socialLinks.length > 0 && (
          <div class="flex gap-3">
            {socialLinks.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-silver-400 hover:text-accent transition-colors" aria-label={s.platform}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
              </a>
            ))}
          </div>
        )}

        <LocaleSwitcher locale={locale} />
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-8 pt-6 border-t border-silver-200 text-center text-xs text-silver-400">
      &copy; {currentYear} {siteConfig.name}. {t(locale, 'footer.rights')}
    </div>
  </div>
</footer>
