---
import { siteConfig } from '@src/config/site';
import { navItems } from '@src/config/site';
import { t, getLocalizedUrl } from '@theme/i18n/utils';

export interface Props {
  type?: 'website' | 'about' | 'contact' | 'article';
  locale?: string;
  articleData?: {
    title: string;
    description: string;
    image?: string;
    datePublished: string;
    author: string;
  };
}

const { type = 'website', locale = 'en', articleData } = Astro.props;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  url: siteConfig.url,
  email: siteConfig.email,
  description: siteConfig.description,
};

const navSchema = {
  '@context': 'https://schema.org',
  '@type': 'SiteNavigationElement',
  name: navItems.map(n => t(locale, n.key)),
  url: navItems.map(n => `${siteConfig.url}${getLocalizedUrl(locale, n.path)}`),
};

const schemas: object[] = [orgSchema, navSchema];

if (type === 'website') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'HVAC Duct Calculator',
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Web',
    description: 'Free online HVAC duct sizing calculator for professionals and homeowners. Calculate duct dimensions, CFM airflow, friction loss, and velocity.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'HVAC Duct Calculator',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    browserRequirements: 'requires HTML5 support',
    url: siteConfig.url,
  });
}

if (type === 'about') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: t(locale, 'about.title'),
    url: `${siteConfig.url}${getLocalizedUrl(locale, '/about-us')}`,
  });
}

if (type === 'contact') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: t(locale, 'contact.title'),
    url: `${siteConfig.url}${getLocalizedUrl(locale, '/contact-us')}`,
  });
}

if (type === 'article' && articleData) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleData.title,
    description: articleData.description,
    image: articleData.image ? `${siteConfig.url}${articleData.image}` : undefined,
    datePublished: articleData.datePublished,
    author: { '@type': 'Person', name: articleData.author },
    publisher: { '@type': 'Organization', name: siteConfig.name },
  });
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'nav.home'), item: `${siteConfig.url}${getLocalizedUrl(locale, '/')}` },
      { '@type': 'ListItem', position: 2, name: t(locale, 'nav.blog'), item: `${siteConfig.url}${getLocalizedUrl(locale, '/blog')}` },
      { '@type': 'ListItem', position: 3, name: articleData.title },
    ],
  });
}

if (type === 'faq') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a friction rate in duct sizing?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Friction rate is the pressure drop per 100 feet of duct length, measured in inches of water gauge (in/wg).'
        }
      },
      {
        '@type': 'Question',
        name: 'How do I size a duct for 400 CFM?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'For 400 CFM at a standard 0.1 friction rate, you typically need a 10-inch round duct or an equivalent rectangular size.'
        }
      }
    ]
  });
}
---

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
