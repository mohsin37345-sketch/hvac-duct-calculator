---
import { t } from '@theme/i18n/utils';
import { siteConfig } from '@src/config/site';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
---

<div class="glass-card p-6 sm:p-8">
  <form id="contactForm" novalidate class="space-y-5">
    <div>
      <label for="contactName" class="block text-xs font-semibold text-silver-500 uppercase tracking-wider mb-2">{t(locale, 'contact.name')}</label>
      <input type="text" id="contactName" name="name" class="form-input" required autocomplete="name" />
    </div>
    <div>
      <label for="contactEmail" class="block text-xs font-semibold text-silver-500 uppercase tracking-wider mb-2">{t(locale, 'contact.email')}</label>
      <input type="email" id="contactEmail" name="email" class="form-input" required autocomplete="email" />
    </div>
    <div>
      <label for="contactReason" class="block text-xs font-semibold text-silver-500 uppercase tracking-wider mb-2">Reason for Contact</label>
      <div class="relative">
        <select id="contactReason" name="reason" class="form-input pr-10 cursor-pointer">
          <option value="question">General Question</option>
          <option value="bug">Report a Calculation Error</option>
          <option value="feature">Feature Suggestion</option>
          <option value="business">Business Inquiry</option>
          <option value="other">Other</option>
        </select>
        <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-silver-400 pointer-events-none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
    </div>
    <div>
      <label for="contactMessage" class="block text-xs font-semibold text-silver-500 uppercase tracking-wider mb-2">{t(locale, 'contact.message')}</label>
      <textarea id="contactMessage" name="message" rows="5" class="form-input resize-y" required></textarea>
    </div>
    <button type="submit" class="btn-primary w-full" id="contactSubmit">
      <span id="contactBtnText">{t(locale, 'contact.send')}</span>
    </button>
    <div id="contactStatus" class="hidden text-sm text-center py-3 rounded-lg"></div>
    <p class="text-xs text-silver-400 text-center">
      {t(locale, 'contact.fallback')} <a href={`mailto:${siteConfig.email}`} class="text-accent hover:underline">{siteConfig.email}</a>
    </p>
  </form>
</div>

<script define:vars={{ email: siteConfig.email, successMsg: t(locale, 'contact.success'), errorMsg: t(locale, 'contact.error'), sendingMsg: t(locale, 'contact.sending'), sendMsg: t(locale, 'contact.send') }}>
  const form = document.getElementById('contactForm');
  const btnText = document.getElementById('contactBtnText');
  const statusEl = document.getElementById('contactStatus');
  const submitBtn = document.getElementById('contactSubmit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (btnText) btnText.textContent = sendingMsg;
    submitBtn?.setAttribute('disabled', 'true');

    const data = new FormData(form);
    const name = data.get('name');
    const userEmail = data.get('email');
    const reason = data.get('reason');
    const message = data.get('message');

    // Fallback: open mailto
    const subject = encodeURIComponent(`Contact [${reason}] from ${name}`);
    const body = encodeURIComponent(`Name: ${name}\nEmail: ${userEmail}\nReason: ${reason}\n\n${message}`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;

    if (statusEl) {
      statusEl.textContent = successMsg;
      statusEl.className = 'text-sm text-center py-3 rounded-lg bg-green-50 text-green-700';
    }
    if (btnText) btnText.textContent = sendMsg;
    submitBtn?.removeAttribute('disabled');
    form.reset();
  });
</script>
