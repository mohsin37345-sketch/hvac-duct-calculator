---
import { getLocalizedUrl } from '@theme/i18n/utils';

export interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  image?: string;
  category?: string;
  locale?: string;
}

const { title, description, date, slug, image, category, locale = 'en' } = Astro.props;
const href = getLocalizedUrl(locale, `/blog/${slug}`);
const dateStr = date.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="glass-card overflow-hidden group hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
  {image && (
    <div class="h-44 overflow-hidden">
      <img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
    </div>
  )}
  <div class="p-5">
    {category && (
      <span class="inline-block text-xs font-bold text-accent uppercase tracking-wider mb-2">{category}</span>
    )}
    <h3 class="text-lg font-bold text-silver-900 mb-2 leading-snug">
      <a href={href} class="hover:text-accent transition-colors no-underline">{title}</a>
    </h3>
    <p class="text-sm text-silver-500 leading-relaxed mb-3 line-clamp-3">{description}</p>
    <time class="text-xs text-silver-400" datetime={date.toISOString()}>{dateStr}</time>
  </div>
</article>
