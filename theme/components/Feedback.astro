---
import { t } from '@theme/i18n/utils';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
---

<section class="my-16 text-center py-10 px-6 rounded-3xl bg-silver-100/50 border border-silver-200">
  <h3 class="text-xl font-bold text-silver-900 mb-2">Was this HVAC duct calculator helpful?</h3>
  <p class="text-silver-500 text-sm mb-6">Your feedback helps us improve our free tools for the HVAC community.</p>
  
  <div class="flex justify-center gap-4" id="feedback-buttons">
    <button type="button" class="flex items-center gap-2 px-6 py-2 bg-white border border-silver-200 rounded-full hover:border-accent hover:text-accent transition-all font-semibold text-sm feedback-btn" data-value="yes">
      <span>👍 Yes, very helpful</span>
    </button>
    <button type="button" class="flex items-center gap-2 px-6 py-2 bg-white border border-silver-200 rounded-full hover:border-amber-500 hover:text-amber-600 transition-all font-semibold text-sm feedback-btn" data-value="no">
      <span>👎 Could be better</span>
    </button>
  </div>

  <div id="feedback-thanks" class="hidden animate-fade-in">
    <div class="inline-flex items-center gap-2 px-6 py-2 bg-accent-subtle text-accent rounded-full font-bold text-sm">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
      Thank you for your feedback!
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.feedback-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('feedback-buttons').classList.add('hidden');
      document.getElementById('feedback-thanks').classList.remove('hidden');
      // In a real app, you would send this to an analytics endpoint
      console.log('Feedback received:', btn.dataset.value);
    });
  });
</script>
