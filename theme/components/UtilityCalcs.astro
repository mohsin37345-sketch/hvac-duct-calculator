---
import { t } from '@theme/i18n/utils';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
---

<div class="space-y-4" id="utility-calcs">
  <!-- Rect to Round -->
  <div class="glass-card overflow-hidden">
    <button type="button" class="accordion-header" aria-expanded="false" data-accordion="rectToRound">
      <h3 class="text-sm font-semibold">{t(locale, 'calc.rectToRound')}</h3>
      <svg class="accordion-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="accordion-panel" id="panel-rectToRound">
      <form id="rectToRoundForm" novalidate class="space-y-4">
        <div class="flex flex-col sm:flex-row items-end gap-4">
          <div class="flex-1 w-full">
            <label class="block text-xs font-semibold text-silver-500 uppercase tracking-wider mb-2"><span class="text-accent mr-1">*</span>{t(locale, 'calc.side1')}:</label>
            <div class="relative">
              <input type="text" id="rectSide1" class="form-input pr-16" inputmode="decimal" placeholder="0" autocomplete="off" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-silver-400 pointer-events-none">Inches</span>
            </div>
          </div>
          <div class="flex-1 w-full">
            <label class="block text-xs font-semibold text-silver-500 uppercase tracking-wider mb-2"><span class="text-accent mr-1">*</span>{t(locale, 'calc.side2')}:</label>
            <div class="relative">
              <input type="text" id="rectSide2" class="form-input pr-16" inputmode="decimal" placeholder="0" autocomplete="off" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-silver-400 pointer-events-none">Inches</span>
            </div>
          </div>
          <button type="submit" class="btn-primary whitespace-nowrap">{t(locale, 'calc.calculate')}</button>
        </div>
        <div class="hidden" id="resultRectToRound">
          <div class="flex items-center justify-between bg-accent-subtle border border-accent/10 rounded-lg px-4 py-3">
            <span class="text-sm text-silver-600">{t(locale, 'calc.roundEquiv')}</span>
            <span class="text-xl font-extrabold text-accent" id="resultRectToRoundValue">—</span>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Diameter to Rect -->
  <div class="glass-card overflow-hidden">
    <button type="button" class="accordion-header" aria-expanded="false" data-accordion="diaToRect">
      <h3 class="text-sm font-semibold">{t(locale, 'calc.diaToRect')}</h3>
      <svg class="accordion-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="accordion-panel" id="panel-diaToRect">
      <form id="diaToRectForm" novalidate class="space-y-4">
        <div class="flex flex-col sm:flex-row items-end gap-4">
          <div class="flex-1 w-full">
            <label class="block text-xs font-semibold text-silver-500 uppercase tracking-wider mb-2"><span class="text-accent mr-1">*</span>{t(locale, 'calc.diameter')}:</label>
            <div class="relative">
              <input type="text" id="diaInput" class="form-input pr-16" inputmode="decimal" placeholder="0" autocomplete="off" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-silver-400 pointer-events-none">Inches</span>
            </div>
          </div>
          <div class="flex-1 w-full">
            <label class="block text-xs font-semibold text-silver-500 uppercase tracking-wider mb-2"><span class="text-accent mr-1">*</span>{t(locale, 'calc.side1')}:</label>
            <div class="relative">
              <input type="text" id="diaSide1" class="form-input pr-16" inputmode="decimal" placeholder="0" autocomplete="off" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-silver-400 pointer-events-none">Inches</span>
            </div>
          </div>
          <button type="submit" class="btn-primary whitespace-nowrap">{t(locale, 'calc.calculate')}</button>
        </div>
        <div class="hidden" id="resultDiaToRect">
          <div class="flex items-center justify-between bg-accent-subtle border border-accent/10 rounded-lg px-4 py-3">
            <span class="text-sm text-silver-600">{t(locale, 'calc.rectSide2')}</span>
            <span class="text-xl font-extrabold text-accent" id="resultDiaToRectValue">—</span>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.accordion-header').forEach(header => {
    header.addEventListener('click', () => {
      const expanded = header.getAttribute('aria-expanded') === 'true';
      header.setAttribute('aria-expanded', String(!expanded));
      const panelId = 'panel-' + (header as HTMLElement).dataset.accordion;
      const panel = document.getElementById(panelId!);
      panel?.classList.toggle('open');
    });
  });

  document.getElementById('rectToRoundForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const s1 = parseFloat((document.getElementById('rectSide1') as HTMLInputElement).value);
    const s2 = parseFloat((document.getElementById('rectSide2') as HTMLInputElement).value);
    if (isNaN(s1) || s1 <= 0 || isNaN(s2) || s2 <= 0) return;
    const De = 1.3 * Math.pow(s1 * s2, 0.625) / Math.pow(s1 + s2, 0.25);
    document.getElementById('resultRectToRoundValue')!.textContent = De.toFixed(2) + ' inches';
    document.getElementById('resultRectToRound')!.classList.remove('hidden');
  });

  document.getElementById('diaToRectForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const dia = parseFloat((document.getElementById('diaInput') as HTMLInputElement).value);
    const side1 = parseFloat((document.getElementById('diaSide1') as HTMLInputElement).value);
    if (isNaN(dia) || dia <= 0 || isNaN(side1) || side1 <= 0) return;
    let side2 = dia;
    for (let i = 0; i < 50; i++) {
      const De = 1.3 * Math.pow(side1 * side2, 0.625) / Math.pow(side1 + side2, 0.25);
      const error = De - dia;
      if (Math.abs(error) < 0.01) break;
      side2 -= error * 0.8;
      if (side2 < 1) side2 = 1;
    }
    document.getElementById('resultDiaToRectValue')!.textContent = side2.toFixed(2) + ' inches';
    document.getElementById('resultDiaToRect')!.classList.remove('hidden');
  });
</script>
